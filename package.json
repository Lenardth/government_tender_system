{
  "name": "government-tender-system",
  "version": "1.0.0",
  "description": "South African Government Tender Monitoring & Verification System",
  "main": "server/server.js",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "api:build": "go build -o bin/api ./cmd/api",
    "api:run": "go run ./cmd/api",
    "api:tidy": "go mod tidy",
    "db:setup": "mysql -u root -p < database/schema.sql",
    "db:seed": "mysql -u root -p tender_system < database/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lenardth/government_tender_system.git"
  }
}
